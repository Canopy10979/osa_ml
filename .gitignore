venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.log
.ipynb_checkpoints/
.DS_Store

# Ignore raw dataset files while preserving raw directory metadata
**/raw/*
!**/raw/.gitignore
!**/raw/README.md

# Large regenerable artifacts: model binaries and the CSV mirrors of the
# structured parquet. Both are rebuilt by the per-dataset pipelines; the
# parquet, metrics and reports are tracked.
**/models/*.joblib
**/structured/minute_features.csv
**/structured/epoch_features.csv

# Throwaway dataset-fetching scratch (hardcoded URLs, print debugging).
tmp_*.py
